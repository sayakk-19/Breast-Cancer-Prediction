# Copy to .env in the project root. Keep real credentials out of Git and chat.
# Leave empty for existing local SQLite storage; set a Neon pooled URL for PostgreSQL.
DATABASE_URL=
# Example format only:
# DATABASE_URL=postgresql://ROLE:PASSWORD@HOST-pooler.REGION.aws.neon.tech/breast_cancer_insight?sslmode=require&channel_binding=require

SESSION_TTL_HOURS=8
# Set true when deployed behind HTTPS; keep false for local HTTP development.
SESSION_COOKIE_SECURE=false
# For deployment, replace these with the exact frontend HTTPS origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
